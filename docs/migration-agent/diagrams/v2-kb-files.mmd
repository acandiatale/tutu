flowchart TB
  KB["kb-v2/ (파일만, DB 없음)"]
  KB --> EJ["errors.jsonl<br/>모든 실행의 오류 한 줄씩<br/>tries · resolved · resolved_by · hunks"]
  KB --> CM["cases.md<br/>사람이 읽는 케이스 표<br/>seen · resolved · last_result"]
  KB --> LY["libraries.yml<br/>사람이 넣는 라이브러리 표<br/>jakarta 버전 · allow_major"]
  KB --> CS["cases/&lt;case_id&gt;/"]
  CS --> CJ["case.json<br/>name · l2 · seen · resolved · projects<br/>scripts[version, status, successes, failures,<br/>parent, reason, last_failure, runs[]]<br/>pin(block) · last_solution"]
  CS --> FV["fix_v1.py · fix_v2.py …<br/>LLM 이 쓴 수정 스크립트 버전"]
  CS --> ER["errors/&lt;run&gt;-&lt;entry&gt;.json<br/>오류 한 건의 전체 기록<br/>as-is / to-be 코드 조각"]
  KB --> LK[".lock<br/>프로세스 간 잠금 (플릿 · 웹 · kb 명령)"]
  RI["sbmig kb reindex<br/>errors.jsonl 로부터 모두 다시 셈<br/>옛 기록 보충"] -.-> CS
  RI -.-> CM
  style KB fill:#2C5F2D,color:#fff
