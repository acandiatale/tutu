package {{ package }};

import org.springframework.boot.SpringApplication;
import org.springframework.boot.autoconfigure.SpringBootApplication;
{%- if servlet_component_scan %}
import {{ servlet_component_scan_fqcn }};
{%- endif %}
{%- if import_resources %}
import org.springframework.context.annotation.ImportResource;
{%- endif %}

/**
 * Spring Boot entry point generated by sbmig during restructuring ({{ case_type }}).
{%- if servlet_component_scan %}
 * {@code @ServletComponentScan} registers {@code @WebServlet}/{@code @WebFilter}/{@code @WebListener} classes;
 * web.xml is NOT read by the embedded container.
{%- endif %}
{%- if import_resources %}
 * Legacy XML bean definitions are imported with {@code @ImportResource} (copied to legacy-config/).
{%- endif %}
 */
@SpringBootApplication
{%- if servlet_component_scan %}
@ServletComponentScan
{%- endif %}
{%- if import_resources %}
@ImportResource({
{%- for r in import_resources %}
        "{{ r }}"{{ "," if not loop.last }}
{%- endfor %}
})
{%- endif %}
public class {{ class_name }} {

    public static void main(String[] args) {
        SpringApplication.run({{ class_name }}.class, args);
    }
}
