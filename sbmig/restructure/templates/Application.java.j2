package {{ package }};

import org.springframework.boot.SpringApplication;
import org.springframework.boot.autoconfigure.SpringBootApplication;
{%- if servlet_component_scan %}
import {{ servlet_component_scan_fqcn }};
{%- endif %}
{%- if servlet_initializer %}
import org.springframework.boot.builder.SpringApplicationBuilder;
import org.springframework.boot.web.servlet.support.SpringBootServletInitializer;
{%- endif %}
{%- if import_resources %}
import org.springframework.context.annotation.ImportResource;
{%- endif %}

/**
 * Spring Boot entry point generated by sbmig during restructuring ({{ case_type }}).
{%- if servlet_component_scan %}
 * {@code @ServletComponentScan} registers {@code @WebServlet}/{@code @WebFilter}/{@code @WebListener} classes;
 * web.xml is NOT read by the embedded container.
{%- endif %}
{%- if import_resources %}
 * Legacy XML bean definitions are imported with {@code @ImportResource} (copied to legacy-config/).
{%- endif %}
{%- if servlet_initializer %}
 * Packaged as an executable WAR: {@code java -jar} runs the embedded Tomcat; {@link SpringBootServletInitializer}
 * boots the same WAR when it is deployed to an external Tomcat instead.
{%- endif %}
 */
@SpringBootApplication
{%- if servlet_component_scan %}
@ServletComponentScan
{%- endif %}
{%- if import_resources %}
@ImportResource({
{%- for r in import_resources %}
        "{{ r }}"{{ "," if not loop.last }}
{%- endfor %}
})
{%- endif %}
public class {{ class_name }}{% if servlet_initializer %} extends SpringBootServletInitializer{% endif %} {
{%- if servlet_initializer %}

    @Override
    protected SpringApplicationBuilder configure(SpringApplicationBuilder builder) {
        return builder.sources({{ class_name }}.class);
    }
{%- endif %}

    public static void main(String[] args) {
        SpringApplication.run({{ class_name }}.class, args);
    }
}
