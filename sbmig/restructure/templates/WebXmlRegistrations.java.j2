package {{ package }};
{% if filters | selectattr("proxy") | list %}
import org.springframework.boot.web.servlet.DelegatingFilterProxyRegistrationBean;
{%- endif %}
{%- if filters | rejectattr("proxy") | list %}
import org.springframework.boot.web.servlet.FilterRegistrationBean;
{%- endif %}
{%- if listeners %}
import org.springframework.boot.web.servlet.ServletListenerRegistrationBean;
{%- endif %}
{%- if servlets %}
import org.springframework.boot.web.servlet.ServletRegistrationBean;
{%- endif %}
{%- if error_pages %}
import org.springframework.boot.web.error.ErrorPage;
import org.springframework.boot.web.error.ErrorPageRegistrar;
{%- endif %}
import org.springframework.context.annotation.Bean;
import org.springframework.context.annotation.Configuration;

/**
 * Generated by sbmig on {{ date }} from {@code {{ web_xml_path }}} (Servlet {{ spec or "spec unknown" }}).
 * <p>
 * web.xml is not read by Spring Boot: the embedded Tomcat ({@code java -jar}) ignores it and the Boot WAR does not
 * package it. These beans
 * replace its {@code <servlet>} / {@code <filter>} / {@code <listener>} / {@code <error-page>} declarations
 * ({@code @ServletComponentScan} on the Application still registers {@code @WebServlet} / {@code @WebFilter} /
 * {@code @WebListener} classes; those are not repeated here). Filter orders follow the web.xml
 * {@code <filter-mapping>} order (1, 2, ...); Spring Boot's own filters keep their own orders.
{%- if skipped %}
 * <p>
 * Not registered here (Spring Boot provides them or they are not needed):
 * <ul>
{%- for s in skipped %}
 * <li>{@code {{ s.cls }}} ({{ s.kind }} {{ s.name }}): {{ s.reason }}</li>
{%- endfor %}
 * </ul>
{%- endif %}
{%- if notes %}
 * <p>
 * Notes:
 * <ul>
{%- for n in notes %}
 * <li>{{ n }}</li>
{%- endfor %}
 * </ul>
{%- endif %}
 */
@Configuration(proxyBeanMethods = false)
public class {{ class_name }} {
{%- for s in servlets %}

    /** web.xml servlet {@code {{ s.name }}}{% if s.patterns %} -> {{ s.patterns_doc }}{% else %} (no servlet-mapping){% endif %}. */
    @Bean
    public ServletRegistrationBean<{{ s.type }}> {{ s.bean }}() {
        ServletRegistrationBean<{{ s.type }}> bean = new ServletRegistrationBean<>(new {{ s.cls }}(){% if s.patterns %}{% for p in s.patterns %}, {{ p }}{% endfor %}{% else %}, false{% endif %});
        bean.setName({{ s.name_lit }});
{%- if s.load_on_startup is not none %}
        bean.setLoadOnStartup({{ s.load_on_startup }});
{%- endif %}
{%- for k, v in s.params %}
        bean.addInitParameter({{ k }}, {{ v }});
{%- endfor %}
{%- if s.async %}
        bean.setAsyncSupported(true);
{%- endif %}
{%- if s.multipart %}
        bean.setMultipartConfig(new jakarta.servlet.MultipartConfigElement({{ s.multipart }}));
{%- endif %}
        return bean;
    }
{%- endfor %}
{%- for f in filters %}
{%- if f.proxy %}

    /** web.xml filter {@code {{ f.name }}} (DelegatingFilterProxy to the bean {@code {{ f.proxy_doc }}}, chain position {{ f.order }}). */
    @Bean
    public DelegatingFilterProxyRegistrationBean {{ f.bean }}() {
        DelegatingFilterProxyRegistrationBean bean = new DelegatingFilterProxyRegistrationBean({{ f.proxy }});
{%- else %}

    /** web.xml filter {@code {{ f.name }}} (chain position {{ f.order }}). */
    @Bean
    public FilterRegistrationBean<jakarta.servlet.Filter> {{ f.bean }}() {
        FilterRegistrationBean<jakarta.servlet.Filter> bean = new FilterRegistrationBean<>(new {{ f.cls }}());
{%- endif %}
        bean.setName({{ f.name_lit }});
{%- if f.patterns %}
        bean.addUrlPatterns({{ f.patterns | join(", ") }});
{%- endif %}
{%- if f.servlet_names %}
        bean.addServletNames({{ f.servlet_names | join(", ") }});
{%- endif %}
{%- if f.dispatchers %}
        bean.setDispatcherTypes({{ f.dispatchers | join(", ") }});
{%- endif %}
{%- for k, v in f.params %}
        bean.addInitParameter({{ k }}, {{ v }});
{%- endfor %}
{%- if f.async %}
        bean.setAsyncSupported(true);
{%- endif %}
        bean.setOrder({{ f.order }});
        return bean;
    }
{%- endfor %}
{%- for l in listeners %}

    /** web.xml listener {@code {{ l.cls }}}. */
    @Bean
    public ServletListenerRegistrationBean<java.util.EventListener> {{ l.bean }}() {
        return new ServletListenerRegistrationBean<>(new {{ l.cls }}());
    }
{%- endfor %}
{%- if error_pages %}

    /** web.xml error pages (Spring Boot applies them through its error page registry / ErrorPageFilter). */
    @Bean
    public ErrorPageRegistrar webXmlErrorPages() {
        return registry -> registry.addErrorPages(
{%- for e in error_pages %}
                {{ e }}{{ "," if not loop.last else ");" }}
{%- endfor %}
    }
{%- endif %}
}
