<?xml version="1.0" encoding="UTF-8"?>
<!-- Generated by sbmig (restructure): executable Spring Boot module (Application class, boot resources). -->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>{{ parent.group_id }}</groupId>
        <artifactId>{{ parent.artifact_id }}</artifactId>
        <version>{{ parent.version }}</version>
        <relativePath>{{ relative_path }}</relativePath>
    </parent>

    <artifactId>{{ artifact_id }}</artifactId>
    <packaging>jar</packaging>
{%- if name %}
    <name>{{ name }}</name>
{%- endif %}

    <dependencies>
{%- for d in dependencies %}
        <dependency>
            <groupId>{{ d.group_id }}</groupId>
            <artifactId>{{ d.artifact_id }}</artifactId>
{%- if d.version %}
            <version>{{ d.version }}</version>
{%- endif %}
{%- if d.type %}
            <type>{{ d.type }}</type>
{%- endif %}
{%- if d.scope %}
            <scope>{{ d.scope }}</scope>
{%- endif %}
        </dependency>
{%- endfor %}
    </dependencies>

    <build>
{%- if final_name %}
        <finalName>{{ final_name }}</finalName>
{%- endif %}
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
{%- if plugin_version %}
                <version>{{ plugin_version }}</version>
{%- endif %}
{%- if main_class %}
                <configuration>
                    <mainClass>{{ main_class }}</mainClass>
                </configuration>
{%- endif %}
                <executions>
                    <execution>
                        <goals>
                            <goal>repackage</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
