# Copy to .env at the sbmig repo root (git-ignored). load_config reads it; variables already set in the shell win.
LLM_BASE_URL=http://llm-gateway.example.internal/v1/chat     # the FULL endpoint URL, used verbatim
LLM_API_KEY=put-the-bearer-token-here
LLM_MODEL=gpt-6-luna                          # fix model: code patches in the build-fix loop
# LLM_ESCALATION_MODEL=                        # stronger model for a cluster that stalled (empty = LLM_MODEL)
# LLM_RECIPE_MODEL=                            # cheaper model for plan advice / KB recipe candidates (empty = LLM_MODEL)
# LLM_RESPONSE_PATH=data.result.content     # only if `sbmig llm-probe` cannot find the reply text
LLM_RECORD_DIR=out/llm-records               # keep every request/response (no secrets) for support
JAVA21_HOME=C:/Program Files/Java/jdk-21
# SBMIG_WEB_OUT=out/web                     # plain uvicorn only (`sbmig serve` takes --out)
# SBMIG_MAX_UPLOAD_MB=0                     # web upload cap in MB, 0 = none (default 512); read when the server starts
