# Copy to .env at the sbmig repo root (git-ignored). load_config reads it; variables already set in the shell win.
LLM_BASE_URL=http://llm-gateway.example.internal/v1/chat     # the FULL endpoint URL, used verbatim
LLM_API_KEY=put-the-bearer-token-here
LLM_MODEL=gpt-6-luna                          # fix model: code patches in the build-fix loop
# LLM_ESCALATION_MODEL=                        # stronger model for a cluster that stalled (empty = LLM_MODEL)
# LLM_RECIPE_MODEL=                            # cheaper model for plan advice / KB recipe candidates (empty = LLM_MODEL)
#   (a model name is one token: `KEY=name   # comment` — a `# comment` alone, or after the name, is ignored)
# LLM_RESPONSE_PATH=data.result.content     # only if `sbmig llm-probe` cannot find the reply text
LLM_RECORD_DIR=out/llm-records               # keep every request/response (no secrets) for support
# --- in-house GPT agent gateway (v2.1z-m); leave unset for the legacy gateway shape ---
# LLM_GATEWAY=agent                          # payload {model: <asset id>, messages, stream: false, async: false, params: {role}, ...}
# LLM_ASSET_ID=put-the-gateway-asset-id-here  # the top-level `model` of the agent gateway
#   (the call URL carries it too: LLM_BASE_URL=https://gateway.example.internal/api/serv/v1/agents/{asset_id}/chat/completions —
#    `{asset_id}` is filled from LLM_ASSET_ID, so the id lives in one place)
# LLM_MODEL=build_error_fixer                # agent mode: params.role of the fix / review calls (the gateway maps it to gpt-5.5)
# LLM_ESCALATION_MODEL=escalation_fixer      # agent mode: params.role from the 3rd ask / after a stall (gpt-5.6-sol)
# LLM_TOKEN_URL=https://gateway.example.internal/oauth/token   # POST with Bearer <app token> → access_token (expires_in)
# LLM_APP_TOKEN=put-the-app-token-here        # the app token for the exchange (unset = LLM_API_KEY is the app token)
JAVA21_HOME=C:/Program Files/Java/jdk-21
# SBMIG_WEB_OUT=out/web                     # plain uvicorn only (`sbmig serve` takes --out)
# SBMIG_MAX_UPLOAD_MB=0                     # web upload cap in MB, 0 = none (default 512); read when the server starts

# ---- 취약점 조치 (이관이 BUILD SUCCESS 로 끝난 뒤 이어서 도는 단계) ----
# 세 값이 없으면 조치 단계는 건너뛴다(SBMIG-RESULT 줄 끝에 remediation=skipped).
# IVAS_BASE_URL=https://<IVAS 주소>[:포트]/<기본 경로>
# IVAS_USER_ID=<IVAS 계정>
# IVAS_PASSWORD=<IVAS 비밀번호>
# 켜기 스위치(코드 기본은 꺼짐):
# SBMIG_REMEDIATION__AFTER_MIGRATION=true
