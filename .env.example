# Copy to .env (git-ignored) at the sbmig repo root — or set SBMIG_ENV_FILE=<path>. Existing env vars win.
# Keys never go into config/*.yml: `llm.api_key_env` names the VARIABLE, the value lives here or in the shell.
LLM_BASE_URL=http://llm-gateway.example.internal/v1/chat   # http or https: the URL is used exactly as given
LLM_API_KEY=put-the-bearer-token-here
JAVA21_HOME=C:/Program Files/Java/jdk-21
# SBMIG_WEB_OUT=out/web
