# copy to coding/.env (git-ignored) and fill in
CODING_API_URL=http://llm-gateway.example.internal/v1/chat
CODING_API_KEY=put-the-bearer-token-here
CODING_MODEL=gpt-6-luna
CODING_NEED_ORIGIN=true
CODING_TIMEOUT=180
# set only if --probe cannot find the reply text, e.g. choices.0.message.content
# CODING_RESPONSE_PATH=
# extra payload fields, JSON
# CODING_EXTRA_JSON={"temperature": 0}
