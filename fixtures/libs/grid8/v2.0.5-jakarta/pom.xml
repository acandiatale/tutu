<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- Simulated commercial grid library (NOT on Maven Central): installed into the local repo by fixtures/libs/install.sh.
         Shape of a company case (2026-11-02): version-line digits in groupId and artifactId, the 1.x releases on javax.servlet,
         the 2.0.5-jakarta release on jakarta.servlet with a SILENT pom (no dependencies) — only the version qualifier / a jar
         scan tells it apart. -->
    <groupId>com.example.grid8</groupId>
    <artifactId>grid8</artifactId>
    <version>2.0.5-jakarta</version>
    <packaging>jar</packaging>
    <name>grid8</name>
    <description>Vendor grid component 2.0.5-jakarta (jakarta.servlet build, dependencies not declared)</description>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <maven.compiler.release>17</maven.compiler.release>
    </properties>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
                <configuration>
                    <!-- the vendor compiles against the container's jar; the published pom stays silent -->
                    <compilerArgs>
                        <arg>-Xlint:none</arg>
                    </compilerArgs>
                </configuration>
            </plugin>
        </plugins>
    </build>
    <!-- build-time only: the dependency is declared in a profile that is active while the stand-in is built here and is
         NOT what the installed pom advertises to consumers (Maven writes the pom as-is, profile included, but the profile
         is inactive for consumers: no dependency reaches them — the pom "says nothing" for sbmig's pom check) -->
    <profiles>
        <profile>
            <id>sbmig-stand-in-build</id>
            <activation>
                <property>
                    <name>sbmig.standin</name>
                </property>
            </activation>
            <dependencies>
                <dependency>
                    <groupId>jakarta.servlet</groupId>
                    <artifactId>jakarta.servlet-api</artifactId>
                    <version>6.1.0</version>
                    <scope>provided</scope>
                </dependency>
            </dependencies>
        </profile>
    </profiles>
</project>
