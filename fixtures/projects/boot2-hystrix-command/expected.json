{
  "case_type": "spring_boot",
  "java_version": "11",
  "spring_boot_version": "2.7.18",
  "spring_version": null,
  "packaging": "jar",
  "libraries": [
    "spring-webmvc",
    "tomcat-embed",
    "spring-cloud",
    "spring-cloud-bom",
    "hystrix",
    "junit5"
  ],
  "optional_artifacts_in_use": [],
  "main_classes": [
    "com.example.stock.StockApiApplication"
  ],
  "catalog": [],
  "expect": {
    "success": true,
    "exit_code": 0,
    "max_llm_calls": 1,
    "blocked": [],
    "unresolved_max": 0,
    "structure_review": {
      "verdict": "issues",
      "critical": 0,
      "warnings_min": 1,
      "script_status": "none",
      "llm_calls_max": 1,
      "issues_contain": [
        "regex:warning module/comp-jar/pom.xml: .*[Hh]ystrix.*"
      ]
    },
    "scripts": {
      "attempts": {
        "new": 0,
        "augment": 0,
        "reuse": 0
      }
    },
    "kb": {
      "dir": "out/e2e/kb-boot2-hystrix-command"
    },
    "advisories": [
      {
        "id": "hystrix",
        "policy": "guide",
        "outcome": "still-present"
      },
      {
        "id": "spring-cloud-bom",
        "outcome": "replaced"
      }
    ],
    "advisories_exact": true,
    "post_checks": [
      {
        "file_contains": {
          "path": "**/com/example/stock/service/InventoryCommand.java",
          "contains": "extends HystrixCommand<Integer>"
        }
      },
      {
        "pom_dependency_present": {
          "path": "module/comp-jar/pom.xml",
          "artifacts": [
            "org.springframework.cloud:spring-cloud-starter-netflix-hystrix"
          ]
        }
      }
    ]
  }
}
