{
  "case_type": "msa",
  "java_version": null,
  "spring_boot_version": null,
  "spring_version": null,
  "packaging": "pom",
  "libraries": ["lombok", "validation", "jpa", "servlet"],
  "optional_artifacts_in_use": ["org.projectlombok:lombok"],
  "main_classes": ["com.example.shop.order.OrderServiceApplication", "com.example.shop.user.UserServiceApplication"],
  "services": [
    {"name": "order-service", "root_pom": "order-service/pom.xml", "case_type": "spring_boot", "spring_boot_version": "2.7.18", "java_version": "11"},
    {"name": "user-service", "root_pom": "user-service/pom.xml", "case_type": "spring_boot", "spring_boot_version": "3.3.13", "java_version": "17"}
  ],
  "libraries_modules": [
    {"name": "common", "root_pom": "common/pom.xml", "case_type": "pure_java", "java_version": "1.8"}
  ],
  "catalog": ["S1"],
  "expect": {
    "success": true,
    "exit_code": 0,
    "max_llm_calls": 4,
    "blocked": [],
    "unresolved_max": 0,
    "structure_review": {
      "verdict": "issues",
      "critical": 0,
      "warnings_min": 2,
      "script_status": "none",
      "llm_calls_max": 1
    },
    "scripts": {
      "attempts": {
        "new": 3,
        "augment": 0,
        "reuse": 0
      },
      "cases": [
        {
          "l2": "compile|package_does_not_exist|javax.validation.constraints",
          "modes": [
            "new"
          ]
        },
        {
          "l2": "compile|package_does_not_exist|javax.validation",
          "modes": [
            "new"
          ]
        },
        {
          "l2": "compile|package_does_not_exist|org.springframework.boot.web.client",
          "modes": [
            "new"
          ]
        }
      ]
    },
    "kb": {
      "dir": "out/e2e/kb-msa-shared-lib"
    },
    "post_checks": [
      {
        "file_contains": {
          "path": "**/com/example/shop/common/web/TraceIdFilter.java",
          "contains": "jakarta.servlet.Filter",
          "not_contains": "javax.servlet"
        }
      },
      {
        "file_contains": {
          "path": "**/com/example/shop/common/web/TraceIdFilter.java",
          "contains": "jakarta.annotation.PostConstruct"
        }
      },
      {
        "file_contains": {
          "path": "**/com/example/shop/order/web/OrderController.java",
          "contains": "jakarta.validation.Valid",
          "not_contains": "javax.validation"
        }
      },
      {
        "pom_parent": {
          "path": "common/pom.xml",
          "group_id": "org.springframework.boot",
          "artifact_id": "spring-boot-starter-parent",
          "version": "4.1.0"
        }
      },
      {
        "pom_dependency_absent": {
          "path": "common/pom.xml",
          "artifacts": [
            "org.springframework.boot:spring-boot-starter-validation",
            "org.springframework.boot:spring-boot-starter-actuator"
          ]
        }
      },
      {
        "file_contains": {
          "path": "**/com/example/shop/order/model/OrderView.java",
          "contains": "import jakarta.validation.constraints.NotBlank;",
          "not_contains": "javax."
        }
      },
      {
        "file_contains": {
          "path": "**/com/example/shop/order/OrderServiceApplication.java",
          "contains": "import org.springframework.boot.restclient.RestTemplateBuilder;"
        }
      },
      {
        "pom_dependency_present": {
          "path": "order-service/pom.xml",
          "artifacts": [
            "org.springframework.boot:spring-boot-starter-restclient"
          ]
        }
      }
    ]
  }
}
