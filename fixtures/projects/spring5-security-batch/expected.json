{
  "case_type": "spring_legacy",
  "java_version": "1.8",
  "spring_boot_version": null,
  "spring_version": "5.3.31",
  "packaging": "jar",
  "libraries": [
    "spring-webmvc",
    "spring-context",
    "spring-security",
    "spring-batch",
    "javax-servlet",
    "jdk-removed-apis"
  ],
  "optional_artifacts_in_use": [],
  "main_classes": [],
  "catalog": [
    "E15",
    "E17"
  ],
  "expect": {
    "success": true,
    "exit_code": 0,
    "max_llm_calls": 7,
    "blocked": [],
    "unresolved_max": 0,
    "structure_review": {
      "verdict": "issues",
      "critical": 0,
      "warnings_min": 1,
      "script_status": "none",
      "issues_contain": [
        "regex:warning module/comp-jar/pom.xml: spring-batch-core .*"
      ],
      "issues_not_contain": [
        "5.0.0",
        "regex:.*jakarta\\.servlet-api:\\d.*"
      ],
      "llm_calls_max": 1
    },
    "scripts": {
      "attempts_min": {
        "new": 6
      },
      "attempts": {
        "augment": 0,
        "reuse": 0
      },
      "cases": [
        {
          "l2": "compile|package_does_not_exist|org.springframework.security.access.vote",
          "modes": [
            "new"
          ],
          "outcomes": [
            "improved"
          ]
        },
        {
          "l2": "compile|cannot_find_symbol|BASE64Encoder",
          "modes": [
            "new"
          ],
          "outcomes": [
            "improved"
          ]
        },
        {
          "l2": "compile|other|exception java.io.ioexception is never thrown in body of corresponding try statement",
          "modes": [
            "new"
          ],
          "outcomes": [
            "build_ok"
          ]
        }
      ]
    },
    "kb": {
      "dir": "out/e2e/kb-spring5-security-batch"
    },
    "advisories": [
      {
        "id": "jdk-removed-apis",
        "policy": "guide"
      }
    ],
    "post_checks": [
      {
        "file_contains": {
          "path": "**/com/example/ops/config/WebSecurityConfig.java",
          "contains": "SecurityFilterChain filterChain(HttpSecurity http)",
          "not_contains": "extends WebSecurityConfigurerAdapter"
        }
      },
      {
        "file_contains": {
          "path": "**/com/example/ops/config/WebSecurityConfig.java",
          "contains": "requestMatchers(\"/admin/**\")",
          "not_contains": ".antMatchers("
        }
      },
      {
        "file_contains": {
          "path": "**/com/example/ops/batch/BatchConfig.java",
          "contains": "new JobBuilder(\"cleanupJob\", jobRepository)",
          "not_contains": "JobBuilderFactory jobBuilderFactory"
        }
      },
      {
        "file_contains": {
          "path": "**/com/example/ops/batch/CleanupTasklet.java",
          "contains": "import org.springframework.batch.infrastructure.item.support.ListItemReader;",
          "not_contains": "import org.springframework.batch.item."
        }
      },
      {
        "file_contains": {
          "path": "**/com/example/ops/security/DbUrlSecurityMetadataSource.java",
          "contains": "PathPatternRequestMatcher.pathPattern(HttpMethod.valueOf(method), url)",
          "not_contains": "import org.springframework.security.web.util.matcher.AntPathRequestMatcher;"
        }
      },
      {
        "file_contains": {
          "path": "**/com/example/ops/web/MvcConfig.java",
          "contains": "headers.containsHeader(\"X-Requested-With\") && headers.headerNames().size() > 1",
          "not_contains": "setUseSuffixPatternMatch"
        }
      },
      {
        "file_contains": {
          "path": "**/com/example/ops/web/MvcConfig.java",
          "contains": "configurer.favorParameter(true);",
          "not_contains": "favorPathExtension"
        }
      },
      {
        "file_contains": {
          "path": "**/com/example/ops/util/TokenCodec.java",
          "contains": "catch (IllegalArgumentException e)",
          "not_contains": "import sun.misc"
        }
      },
      {
        "file_contains": {
          "path": "**/com/example/ops/util/TokenCodec.java",
          "contains": "Base64.getMimeDecoder().decode(encoded)"
        }
      },
      {
        "pom_dependency_present": {
          "path": "module/comp-jar/pom.xml",
          "artifacts": [
            "org.springframework.security:spring-security-access"
          ]
        }
      },
      {
        "pom_dependency_unversioned": {
          "path": "module/comp-jar/pom.xml",
          "artifacts": [
            "org.springframework:spring-context",
            "org.springframework.batch:spring-batch-core"
          ]
        }
      },
      {
        "file_contains": {
          "path": "pom.xml",
          "not_contains": "<spring-batch.version>"
        }
      },
      {
        "pom_dependency_absent": {
          "path": "**/pom.xml",
          "artifacts": [
            "javax.servlet:javax.servlet-api"
          ]
        }
      }
    ],
    "journal_events": [
      {
        "event": "bom_property_overrides"
      }
    ]
  }
}
