<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.shop.notice">
  <select id="selectNotices" resultType="java.util.Map">
    SELECT NOTICE_ID, TITLE FROM TB_NOTICE ORDER BY NOTICE_ID DESC
  </select>
  <insert id="insertNotice" parameterType="java.util.Map">
    INSERT INTO TB_NOTICE (TITLE) VALUES (#{title})
  </insert>
</mapper>
