{
  "case_type": "spring_boot",
  "java_version": "11",
  "spring_boot_version": "2.7.18",
  "spring_version": null,
  "packaging": "pom",
  "is_multi_module": true,
  "modules": [
    "boot-jar",
    "catalog-service",
    "order-service"
  ],
  "libraries": [
    "lombok",
    "spring-context"
  ],
  "optional_artifacts_in_use": [
    "org.projectlombok:lombok"
  ],
  "main_classes": [
    "com.example.shop.ShopApplication"
  ],
  "catalog": [],
  "expect": {
    "success": true,
    "exit_code": 0,
    "max_llm_calls": 1,
    "blocked": [],
    "unresolved_max": 0,
    "optional_bumped": [],
    "journal_events": [
      {
        "event": "restructure",
        "mode": "boot_pom",
        "ok": true
      }
    ],
    "phases": {
      "restructure": "ok"
    },
    "structure_review": {
      "verdict": "issues",
      "critical": 0,
      "warnings_min": 1,
      "script_status": "none",
      "llm_calls_max": 1,
      "issues_contain": [
        "regex:warning boot-jar/pom.xml: .*-boot.*"
      ]
    },
    "scripts": {
      "attempts": {
        "new": 0,
        "augment": 0,
        "reuse": 0
      }
    },
    "kb": {
      "dir": "out/e2e/kb-legacy-role-parents"
    },
    "post_checks": [
      {
        "pom_parent": {
          "path": "pom.xml",
          "group_id": "org.springframework.boot",
          "artifact_id": "spring-boot-starter-parent",
          "version": "4.1.0"
        }
      },
      {
        "pom_packaging": {
          "path": "pom.xml",
          "packaging": "pom"
        }
      },
      {
        "pom_module_list": {
          "path": "pom.xml",
          "modules": [
            "boot-jar",
            "catalog-service",
            "order-service"
          ]
        }
      },
      {
        "pom_dependency_present": {
          "path": "pom.xml",
          "artifacts": [
            "org.springframework.boot:spring-boot-starter-validation",
            "org.springframework.boot:spring-boot-starter-actuator"
          ]
        }
      },
      {
        "pom_parent": {
          "path": "boot-jar/pom.xml",
          "group_id": "org.springframework.boot",
          "artifact_id": "spring-boot-starter-parent",
          "version": "4.1.0"
        }
      },
      {
        "pom_parent": {
          "path": "catalog-service/pom.xml",
          "group_id": "org.springframework.boot",
          "artifact_id": "spring-boot-starter-parent",
          "version": "4.1.0"
        }
      },
      {
        "pom_parent": {
          "path": "order-service/pom.xml",
          "group_id": "org.springframework.boot",
          "artifact_id": "spring-boot-starter-parent",
          "version": "4.1.0"
        }
      },
      {
        "file_contains": {
          "path": "boot-jar/pom.xml",
          "contains": "<relativePath/>"
        }
      },
      {
        "file_contains": {
          "path": "catalog-service/pom.xml",
          "contains": "<relativePath/>"
        }
      },
      {
        "file_contains": {
          "path": "order-service/pom.xml",
          "contains": "<groupId>com.example</groupId>"
        }
      },
      {
        "pom_dependency_absent": {
          "path": "boot-jar/pom.xml",
          "artifacts": [
            "org.springframework.boot:spring-boot-starter-validation",
            "org.springframework.boot:spring-boot-starter-actuator"
          ]
        }
      },
      {
        "pom_dependency_absent": {
          "path": "catalog-service/pom.xml",
          "artifacts": [
            "org.springframework.boot:spring-boot-starter-validation",
            "org.springframework.boot:spring-boot-starter-actuator"
          ]
        }
      },
      {
        "pom_dependency_absent": {
          "path": "order-service/pom.xml",
          "artifacts": [
            "org.springframework.boot:spring-boot-starter-validation",
            "org.springframework.boot:spring-boot-starter-actuator"
          ]
        }
      },
      {
        "pom_dependency_present": {
          "path": "boot-jar/pom.xml",
          "artifacts": [
            "com.example:catalog-service",
            "com.example:order-service"
          ]
        }
      },
      {
        "file_exists": {
          "path": "boot-jar/src/main/java/com/example/shop/ShopApplication.java"
        }
      },
      {
        "file_exists": {
          "path": "catalog-service/src/main/java/com/example/shop/catalog/CatalogService.java"
        }
      },
      {
        "file_exists": {
          "path": "order-service/src/main/java/com/example/shop/order/OrderService.java"
        }
      },
      {
        "file_absent": {
          "path": "module"
        }
      },
      {
        "file_absent": {
          "path": "shop-boot"
        }
      },
      {
        "file_absent": {
          "path": "shop-back"
        }
      }
    ]
  }
}
