{
  "case_type": "spring_boot",
  "java_version": "11",
  "spring_boot_version": "2.7.18",
  "spring_version": null,
  "packaging": "jar",
  "libraries": [
    "spring-webmvc",
    "spring-context",
    "tomcat-embed",
    "spring-cloud",
    "spring-cloud-bom",
    "sleuth",
    "hystrix",
    "springfox",
    "swagger-v1",
    "junit5"
  ],
  "optional_artifacts_in_use": [],
  "main_classes": [
    "com.example.orders.OrderApiApplication"
  ],
  "catalog": [],
  "expect": {
    "success": true,
    "exit_code": 0,
    "max_llm_calls": 0,
    "blocked": [],
    "unresolved_max": 0,
    "advisories": [
      {
        "id": "springfox",
        "policy": "recipe",
        "outcome": "replaced",
        "recipe_source": "plan"
      },
      {
        "id": "sleuth",
        "outcome": "replaced",
        "recipe_source": "plan"
      },
      {
        "id": "hystrix",
        "policy": "recipe",
        "outcome": "replaced",
        "recipe_source": "advisory"
      },
      {
        "id": "spring-cloud-bom",
        "outcome": "replaced"
      }
    ],
    "handover": {
      "carried_over_min": 1,
      "spring_boot_after": "4.1.0",
      "from_here_contains": [
        "regex:(?i).*verify hystrix → org\\.springframework\\.cloud:spring-cloud-starter-circuitbreaker-resilience4j \\(recipe com\\.company\\.migrate\\.HystrixToResilience4j\\).*resilience4j\\.circuitbreaker\\.instances.*",
        "regex:(?i).*net\\.sf\\.ehcache:ehcache pinned at 2\\.10\\.\\S+.*"
      ],
      "removed_contains": [
        "io.springfox:springfox-boot-starter",
        "org.springframework.cloud:spring-cloud-starter-sleuth",
        "org.springframework.cloud:spring-cloud-starter-netflix-hystrix"
      ],
      "added_contains": [
        "org.springdoc:springdoc-openapi-starter-webmvc-ui",
        "org.springframework.cloud:spring-cloud-starter-circuitbreaker-resilience4j"
      ]
    },
    "followups_contains": [
      "regex:(?i).*hystrix → .*resilience4j applied by HystrixToResilience4j.*resilience4j\\.timelimiter.*"
    ],
    "post_checks": [
      {
        "pom_dependency_absent": {
          "path": "**/pom.xml",
          "artifacts": [
            "io.springfox:springfox-boot-starter",
            "org.springframework.cloud:spring-cloud-starter-sleuth",
            "org.springframework.cloud:spring-cloud-starter-netflix-hystrix"
          ]
        }
      },
      {
        "pom_dependency_present": {
          "path": "module/comp-jar/pom.xml",
          "artifacts": [
            "org.springdoc:springdoc-openapi-starter-webmvc-ui"
          ]
        }
      },
      {
        "pom_dependency_present": {
          "path": "module/comp-jar/pom.xml",
          "artifacts": [
            "org.springframework.cloud:spring-cloud-starter-circuitbreaker-resilience4j"
          ]
        }
      },
      {
        "pom_dependency_present": {
          "path": "module/comp-jar/pom.xml",
          "artifacts": [
            "net.sf.ehcache:ehcache"
          ]
        }
      },
      {
        "file_contains": {
          "path": "**/com/example/orders/service/InventoryClient.java",
          "contains": "@CircuitBreaker(name = \"default\", fallbackMethod = \"stockFallback\")",
          "not_contains": "HystrixCommand"
        }
      },
      {
        "file_contains": {
          "path": "**/com/example/orders/service/InventoryClient.java",
          "contains": "@CircuitBreaker(name = \"inventoryReserve\",",
          "not_contains": "HystrixProperty"
        }
      },
      {
        "file_contains": {
          "path": "**/com/example/orders/OrderApiApplication.java",
          "not_contains": "EnableCircuitBreaker"
        }
      }
    ]
  }
}
