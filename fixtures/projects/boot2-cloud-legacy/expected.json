{
  "case_type": "spring_boot",
  "java_version": "11",
  "spring_boot_version": "2.7.18",
  "spring_version": null,
  "packaging": "jar",
  "libraries": [
    "spring-webmvc",
    "spring-context",
    "tomcat-embed",
    "spring-cloud",
    "spring-cloud-bom",
    "sleuth",
    "hystrix",
    "springfox",
    "swagger-v1",
    "junit5"
  ],
  "optional_artifacts_in_use": [],
  "main_classes": [
    "com.example.orders.OrderApiApplication"
  ],
  "catalog": [],
  "expect": {
    "success": true,
    "exit_code": 0,
    "max_llm_calls": 2,
    "blocked": [],
    "unresolved_max": 0,
    "structure_review": {
      "verdict": "issues",
      "critical": 0,
      "warnings_min": 2,
      "script_status": "none",
      "llm_calls_max": 1,
      "issues_contain": [
        "regex:warning module/comp-jar/pom.xml: .*hystrix.*"
      ]
    },
    "scripts": {
      "attempts": {
        "new": 1,
        "augment": 0,
        "reuse": 0
      },
      "cases": [
        {
          "l2": "compile|cannot_find_symbol|EnableCircuitBreaker",
          "modes": [
            "new"
          ],
          "outcomes": [
            "build_ok"
          ]
        }
      ]
    },
    "kb": {
      "dir": "out/e2e/kb-boot2-cloud-legacy"
    },
    "advisories": [
      {
        "id": "springfox",
        "outcome": "replaced"
      },
      {
        "id": "sleuth",
        "outcome": "replaced"
      },
      {
        "id": "hystrix",
        "policy": "guide",
        "outcome": "still-present"
      },
      {
        "id": "spring-cloud-bom",
        "outcome": "replaced"
      }
    ],
    "handover": {
      "carried_over_min": 1,
      "spring_boot_after": "4.1.0",
      "from_here_contains": [
        "regex:(?i).*hystrix.*",
        "regex:(?i).*net\\.sf\\.ehcache:ehcache pinned at 2\\.10\\.\\S+.*"
      ],
      "removed_contains": [
        "io.springfox:springfox-boot-starter",
        "org.springframework.cloud:spring-cloud-starter-sleuth"
      ],
      "added_contains": [
        "org.springdoc:springdoc-openapi-starter-webmvc-ui"
      ]
    },
    "post_checks": [
      {
        "pom_dependency_absent": {
          "path": "**/pom.xml",
          "artifacts": [
            "io.springfox:springfox-boot-starter",
            "org.springframework.cloud:spring-cloud-starter-sleuth"
          ]
        }
      },
      {
        "pom_dependency_present": {
          "path": "module/comp-jar/pom.xml",
          "artifacts": [
            "org.springdoc:springdoc-openapi-starter-webmvc-ui",
            "net.sf.ehcache:ehcache",
            "org.springframework.cloud:spring-cloud-starter-netflix-hystrix"
          ]
        }
      },
      {
        "file_contains": {
          "path": "**/com/example/orders/OrderApiApplication.java",
          "contains": "MIGRATION-TODO: @EnableCircuitBreaker removed",
          "not_contains": "import org.springframework.cloud.client.circuitbreaker.EnableCircuitBreaker;"
        }
      },
      {
        "file_contains": {
          "path": "**/com/example/orders/service/InventoryClient.java",
          "contains": "@HystrixCommand(fallbackMethod = \"stockFallback\")"
        }
      }
    ]
  }
}
