{
  "case_type": "spring_legacy",
  "java_version": "1.8",
  "spring_boot_version": null,
  "spring_version": "5.3.31",
  "packaging": "war",
  "libraries": [
    "spring-webmvc",
    "spring-jdbc",
    "jackson",
    "servlet",
    "junit4",
    "mockito"
  ],
  "optional_artifacts_in_use": [
    "com.fasterxml.jackson.core:jackson-databind",
    "org.slf4j:slf4j-api"
  ],
  "main_classes": [],
  "catalog": [],
  "expect": {
    "success": true,
    "exit_code": 0,
    "max_llm_calls": 1,
    "blocked": [],
    "unresolved_max": 0,
    "optional_bumped": [
      "regex:^org\\.slf4j:slf4j-api \\S+→2\\.0\\.17$"
    ],
    "structure_review": {
      "verdict": "issues",
      "critical": 0,
      "warnings_min": 2,
      "script_status": "none",
      "llm_calls_max": 1
    },
    "scripts": {
      "attempts": {
        "new": 0,
        "augment": 0,
        "reuse": 0
      }
    },
    "kb": {
      "dir": "out/e2e/kb-spring5-xml"
    },
    "post_checks": [
      {
        "file_contains": {
          "path": "**/com/example/catalog/config/WebConfig.java",
          "contains": "public class WebConfig implements WebMvcConfigurer",
          "not_contains": "extends WebMvcConfigurerAdapter"
        }
      },
      {
        "file_contains": {
          "path": "**/com/example/catalog/web/AuditInterceptor.java",
          "contains": "public class AuditInterceptor implements HandlerInterceptor",
          "not_contains": "import org.springframework.web.servlet.handler.HandlerInterceptorAdapter;"
        }
      }
    ]
  }
}
