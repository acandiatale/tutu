{
  "case_type": "spring_boot",
  "java_version": "11",
  "spring_boot_version": "2.7.18",
  "spring_version": null,
  "packaging": "jar",
  "libraries": [
    "spring-security",
    "jpa",
    "lombok",
    "validation",
    "junit5",
    "mockito"
  ],
  "optional_artifacts_in_use": [
    "org.apache.commons:commons-lang3",
    "org.projectlombok:lombok"
  ],
  "main_classes": [
    "com.example.members.MemberApiApplication"
  ],
  "catalog": [
    "X1b"
  ],
  "expect": {
    "success": true,
    "exit_code": 0,
    "max_llm_calls": 2,
    "blocked": [],
    "unresolved_max": 0,
    "optional_bumped": [
      "regex:^org\\.apache\\.commons:commons-lang3 \\S+→3\\.17\\.0$"
    ],
    "structure_review": {
      "verdict": "issues",
      "critical": 0,
      "warnings_min": 1,
      "script_status": "none",
      "llm_calls_max": 1,
      "issues_contain": [
        "regex:warning module/comp-jar/pom.xml: .*QLRM.*"
      ]
    },
    "scripts": {
      "attempts": {
        "new": 1,
        "augment": 0,
        "reuse": 0
      },
      "cases": [
        {
          "l2": "compile|cannot_access|Query",
          "modes": [
            "new"
          ],
          "outcomes": [
            "build_ok"
          ]
        }
      ]
    },
    "kb": {
      "dir": "out/e2e/kb-boot2-qlrm-javax"
    },
    "post_checks": [
      {
        "pom_dependency_present": {
          "path": "module/comp-jar/pom.xml",
          "artifacts": [
            "org.qlrm:qlrm"
          ]
        }
      },
      {
        "file_contains": {
          "path": "module/comp-jar/pom.xml",
          "contains": "<version>4.2.1</version>"
        }
      },
      {
        "pom_dependency_versioned": {
          "path": "module/comp-jar/pom.xml",
          "artifacts": [
            "org.qlrm:qlrm"
          ]
        }
      },
      {
        "pom_dependency_absent": {
          "path": "**/pom.xml",
          "artifacts": [
            "ch.simas.qlrm:qlrm"
          ]
        }
      },
      {
        "file_contains": {
          "path": "**/com/example/members/query/MemberSummaryQuery.java",
          "contains": "jakarta.persistence.Query",
          "not_contains": "javax.persistence"
        }
      }
    ]
  }
}
