  "libraries": [
    "javax-servlet",
    "jsp"
  ],
  "optional_artifacts_in_use": [
    "org.apache.commons:commons-lang3",
    "commons-io:commons-io"
  ],
  "main_classes": [],
  "catalog": [],
  "expect": {
    "success": true,
    "exit_code": 0,
    "max_llm_calls": 0,
