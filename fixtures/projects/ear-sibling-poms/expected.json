    "journal_events": [
      {
        "event": "aggregator_generated",
        "name": "portal",
        "artifact_id": "portal-aggregator"
      },
      {
        "event": "restructure",
        "mode": "layout",
        "ok": true
      }
    ],
    "phases": {
      "restructure": "ok"
    },
    "followups_contains": [
      "regex:(?is).*context.root.*/portal.*",
      "regex:(?s).*STATIC/.*",
      "regex:(?s).*NoticeCleaner.*"
    ],
    "post_checks": [
      {
        "pom_module_list": {
          "path": "pom.xml",
          "modules": [
            "portal-back",
            "portal-front",
            "portal-boot"
          ],
          "any_order": true
        }
      },
      {
        "file_contains": {
          "path": "pom.xml",
          "contains": "<artifactId>portal</artifactId>"
        }
      },
      {
        "pom_parent": {
