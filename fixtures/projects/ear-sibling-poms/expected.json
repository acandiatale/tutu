          "group_id": "org.springframework.boot",
          "artifact_id": "spring-boot-starter-parent",
          "version": "4.1.0"
        }
      },
      {
        "pom_packaging": {
          "path": "portal-boot/pom.xml",
          "packaging": "war"
        }
      },
      {
        "pom_dependency_absent": {
