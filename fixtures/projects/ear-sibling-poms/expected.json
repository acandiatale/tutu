          "artifacts": [
            "com.example.portal:portalWEB",
            "com.example.portal:portalBATCH",
            "com.example.portal:portal"
          ]
        }
      },
      {
        "pom_dependency_absent": {
          "path": "portal-boot/pom.xml",
          "artifacts": [
            "com.example.portal:portalWEB",
            "com.example.portal:portalBATCH"
          ]
        }
      },
      {
        "file_contains": {
          "path": "portal-back/pom.xml",
          "not_contains": "maven-ear-plugin"
        }
      },
      {
        "file_contains": {
          "path": "portal-boot/pom.xml",
          "not_contains": "maven-ear-plugin"
        }
      },
      {
        "pom_dependency_present": {
          "path": "portal-back/pom.xml",
          "artifacts": [
            "commons-io:commons-io"
          ]
        }
      },
      {
        "file_contains": {
          "path": "portal-back/src/main/java/com/example/portal/web/NoticeServlet.java",
          "contains": "jakarta.servlet.http.HttpServlet"
        }
      },
      {
        "file_exists": {
          "path": "portal-back/src/main/java/com/example/portal/batch/NoticeCleaner.java"
        }
      },
      {
        "file_contains": {
          "path": "portal-front/src/main/resources/META-INF/resources/WEB-INF/jsp/notice/list.jsp",
          "contains": "<c:out value=\"${cleaned}\"/>"
        }
      },
      {
        "file_exists": {
          "path": "portal-front/src/main/resources/static/css/portal.css"
        }
      },
      {
        "file_exists": {
          "path": "portal-boot/src/main/resources/asis-ear/**/jeus-application-dd.xml"
        }
      },
      {
        "file_contains": {
          "path": "portal-boot/src/main/java/**/WebXmlRegistrations.java",
