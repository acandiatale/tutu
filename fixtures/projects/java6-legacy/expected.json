{
  "case_type": "pure_java",
  "java_version": "1.6",
  "spring_boot_version": null,
  "spring_version": null,
  "packaging": "jar",
  "libraries": [
    "junit4",
    "jaxb",
    "jdk-removed-apis"
  ],
  "optional_artifacts_in_use": [
    "org.apache.commons:commons-lang3"
  ],
  "main_classes": [],
  "catalog": [
    "S8"
  ],
  "expect": {
    "success": true,
    "exit_code": 0,
    "max_llm_calls": 3,
    "blocked": [],
    "unresolved_max": 0,
    "optional_bumped": [
      "regex:^org\\.apache\\.commons:commons-lang3 \\S+→3\\.17\\.0$"
    ],
    "structure_review": {
      "verdict": "issues",
      "critical": 0,
      "warnings_min": 1,
      "script_status": "none",
      "llm_calls_max": 1,
      "issues_contain": [
        "regex:warning module/comp-jar/pom.xml: .*bootclasspath.*"
      ]
    },
    "scripts": {
      "attempts": {
        "new": 2,
        "augment": 0,
        "reuse": 1
      },
      "reuse_without_llm": true,
      "cases": [
        {
          "l2": "compile|build|compilation failure: compilation failure",
          "modes": [
            "new"
          ],
          "outcomes": [
            "improved"
          ],
          "versions": [
            1
          ],
          "llm_calls": 1
        },
        {
          "l2": "compile|package_does_not_exist|jakarta.xml.bind",
          "modes": [
            "reuse"
          ],
          "outcomes": [
            "build_ok"
          ],
          "versions": [
            1
          ],
          "llm_calls": 0
        }
      ],
      "stored": [
        {
          "l2": "compile|package_does_not_exist|jakarta.xml.bind",
          "version": 1,
          "parent": null,
          "status": "active",
          "successes_min": 2,
          "success_projects_min": 2,
          "last_outcome": "build_ok"
        }
      ],
      "versions": {
        "compile|package_does_not_exist|jakarta.xml.bind": 1
      }
    },
    "kb": {
      "dir": "out/e2e/kb-jaxb",
      "after": "pure-java"
    },
    "error_cases": {
      "records": [
        {
          "file": "regex:.*/com/example/legacy/util/Dates\\.java",
          "status": "resolved",
          "fix_method": "script_reuse"
        }
      ]
    },
    "advisories": [
      {
        "id": "jdk-removed-apis",
        "policy": "guide"
      }
    ],
    "advisories_exact": true,
    "handover": {
      "java_before": "1.6",
      "java_after": "21",
      "added_contains": [
        "jakarta.xml.bind:jakarta.xml.bind-api",
        "org.glassfish.jaxb:jaxb-runtime"
      ]
    },
    "post_checks": [
      {
        "file_contains": {
          "path": "**/pom.xml",
          "not_contains": "<bootclasspath>"
        }
      },
      {
        "file_contains": {
          "path": "**/com/example/legacy/util/Codec.java",
          "contains": "import java.util.Base64;",
          "not_contains": "BASE64Encoder"
        }
      },
      {
        "file_contains": {
          "path": "**/com/example/legacy/util/Codec.java",
          "contains": "Base64.getMimeDecoder().decode(base64)",
          "not_contains": "sun.misc"
        }
      },
      {
        "file_contains": {
          "path": "**/com/example/legacy/util/Dates.java",
          "contains": "import jakarta.xml.bind.DatatypeConverter;",
          "not_contains": "javax.xml.bind"
        }
      },
      {
        "pom_dependency_present": {
          "path": "module/comp-jar/pom.xml",
          "artifacts": [
            "jakarta.xml.bind:jakarta.xml.bind-api",
            "org.glassfish.jaxb:jaxb-runtime"
          ]
        }
      },
      {
        "file_contains": {
          "path": "**/pom.xml",
          "not_contains": "<source>1.6</source>"
        }
      },
      {
        "file_contains": {
          "path": "**/pom.xml",
          "not_contains": "<target>1.6</target>"
        }
      },
      {
        "pom_dependency_unversioned": {
          "path": "module/comp-jar/pom.xml",
          "artifacts": [
            "jakarta.xml.bind:jakarta.xml.bind-api",
            "org.glassfish.jaxb:jaxb-runtime"
          ]
        }
      },
      {
        "pom_dependency_absent": {
          "path": "**/pom.xml",
          "artifacts": [
            "javax.xml.bind:jaxb-api"
          ]
        }
      }
    ]
  }
}
