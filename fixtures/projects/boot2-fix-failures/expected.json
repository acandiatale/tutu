{
  "case_type": "spring_boot",
  "java_version": "11",
  "spring_boot_version": "2.7.18",
  "spring_version": null,
  "packaging": "jar",
  "libraries": [
    "spring-security",
    "jpa",
    "lombok",
    "validation",
    "junit5",
    "mockito"
  ],
  "optional_artifacts_in_use": [
    "org.apache.commons:commons-lang3",
    "org.projectlombok:lombok",
    "com.company.legacy:legacy-web-lib"
  ],
  "main_classes": [
    "com.example.members.MemberApiApplication"
  ],
  "catalog": [
    "X2"
  ],
  "requires_libs": [
    "com.company.legacy:legacy-web-lib:1.0.0",
    "com.company.legacy:legacy-web-lib:3.0.0"
  ],
  "expect": {
    "success": true,
    "exit_code": 0,
    "max_llm_calls": 3,
    "blocked": [],
    "unresolved_max": 0,
    "optional_bumped": [
      "com.company.legacy:legacy-web-lib 1.0.0→3.0.0"
    ],
    "structure_review": {
      "verdict": "ok",
      "critical": 0,
      "llm_calls_max": 1
    },
    "scripts": {
      "attempts": {
        "new": 1,
        "augment": 1,
        "reuse": 0
      },
      "cases": [
        {
          "l2": "compile|cannot_find_symbol|clientIp",
          "modes": [
            "new",
            "augment"
          ],
          "outcomes": [
            "partial",
            "build_ok"
          ],
          "versions": [
            1,
            2
          ],
          "llm_calls": 2
        }
      ],
      "stored": [
        {
          "l2": "compile|cannot_find_symbol|clientIp",
          "version": 1,
          "parent": null,
          "successes_max": 0,
          "last_outcome": "partial",
          "code_contains": [
            "LegacyRequestHelper.clientIp(request)"
          ],
          "status": "active"
        },
        {
          "l2": "compile|cannot_find_symbol|clientIp",
          "version": 2,
          "parent": 1,
          "status": "active",
          "successes_min": 1,
          "success_projects_min": 1,
          "last_outcome": "build_ok",
          "code_contains": [
            "remoteClientIp("
          ]
        }
      ],
      "versions": {
        "compile|cannot_find_symbol|clientIp": 2
      }
    },
    "kb": {
      "dir": "out/e2e/kb-boot2-fix-failures"
    },
    "error_cases": {
      "min": 2,
      "status_min": {
        "resolved": 2
      },
      "records": [
        {
          "file": "regex:.*/web/MemberController\\.java",
          "status": "resolved",
          "fix_method": "script_augment",
          "attempt_outcomes": [
            "partial",
            "build_ok"
          ]
        }
      ],
      "run_files": [
        "error_cases.jsonl",
        "fix_attempts.jsonl",
        "error_cases.csv"
      ],
      "kb_errors_min": 2,
      "kb_attempts_min": 2,
      "kb_cases_min": 1
    },
    "post_checks": [
      {
        "file_contains": {
          "path": "**/com/example/members/web/MemberController.java",
          "contains": "LegacyRequestHelper.remoteClientIp(http)"
        }
      },
      {
        "file_contains": {
          "path": "**/com/example/members/web/ClientIpFilter.java",
          "contains": "LegacyRequestHelper.remoteClientIp(request)"
        }
      }
    ]
  }
}
