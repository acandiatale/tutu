      },
      {
        "file_exists": {
          "path": "shop-boot/bin/src/main/java/com/example/shop/ShopApplication.java"
        }
      },
      {
        "file_absent": {
          "path": "shop-boot/bin/target"
        }
      },
      {
        "file_exists": {
          "path": "shop-boot/target/*.jar"
        }
