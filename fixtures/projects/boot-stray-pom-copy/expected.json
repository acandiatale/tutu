        "augment": 0,
        "reuse": 0
      }
    },
    "kb": {
      "dir": "out/e2e/kb-boot-stray-pom-copy"
    },
    "followups_contains": [
      "regex:^pom copy ignored: `shop-boot/bin/pom\\.xml` has the same coordinates as `shop-boot/pom\\.xml` \\(`com\\.example:shop-boot`\\), lies inside the directory of `shop-boot/pom\\.xml` and no pom lists it as a module — treated as a stray copy \\(an IDE output / backup folder\\): not built, not migrated, left where it is; delete it from the source, or give it its own coordinates and list it in <modules> if it is a real module$"
    ],
    "post_checks": [
