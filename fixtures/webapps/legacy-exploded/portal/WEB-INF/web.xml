<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE web-app PUBLIC "-//Sun Microsystems, Inc.//DTD Web Application 2.3//EN" "http://java.sun.com/dtd/web-app_2_3.dtd">
<web-app>
  <display-name>portal</display-name>
  <filter>
    <filter-name>encoding</filter-name>
    <filter-class>com.acme.portal.EncodingFilter</filter-class>
  </filter>
  <servlet>
    <servlet-name>login</servlet-name>
    <servlet-class>com.acme.portal.LoginServlet</servlet-class>
  </servlet>
  <servlet-mapping>
    <servlet-name>login</servlet-name>
    <url-pattern>/login.do</url-pattern>
  </servlet-mapping>
  <taglib>
    <taglib-uri>/WEB-INF/tld/acme.tld</taglib-uri>
    <taglib-location>/WEB-INF/tld/acme.tld</taglib-location>
  </taglib>
  <resource-ref>
    <res-ref-name>jdbc/PortalDS</res-ref-name>
    <res-type>javax.sql.DataSource</res-type>
    <res-auth>Container</res-auth>
  </resource-ref>
</web-app>
